-- vim: ft=lua ts=2 sw=2 sts=2 et :
-- lib.luk: Lua "battery" for .luk programs. End syntax.
-- usage:  L := require("lib")
--         abs, argmin = L.abs, L.argmin   -- or use L.abs

-- adds :fmt(...) method to all strings (string.format)
getmetatable("").__index.fmt = string.format

abs, max, min := math.abs, math.max, math.min
sqrt, exp, floor := math.sqrt, math.exp, math.floor

sort := fn(t, f) table.sort(t, f); ^ t end

of := fn(z) ^ z=="True" or z~="False" and (tonumber(z) or z) end

sum := fn(xs)
  s := 0
  for _, x in ipairs(xs) do s = s + x end
  ^ s end

argmin := fn(xs, key)
  best, bv := xs[1], key(xs[1])
  for i = 2, #xs do
    v := key(xs[i])
    if v < bv then best, bv = xs[i], v end end
  ^ best end

csv := fn(file)
  u := {}
  for ln in io.lines(file) do
    ln := ln:gsub("^%s+", ""):gsub("%s+$", "")
    if #ln > 0 and ln:sub(1,1) ~= "#" then
      row := {}
      for x in ln:gmatch("[^,]+") do row[#row+1] = of(x) end
      u[#u+1] = row end end
  ^ u end

^ {abs=abs, max=max, min=min, sqrt=sqrt, exp=exp,
   floor=floor, argmin=argmin, sum=sum, sort=sort,
   of=of, csv=csv}
