-- vim: ft=luk ts=2 sw=2 sts=2 et :
-- test_fft.luk: checks for fft.luk.
-- usage: ./luk test_fft.luk [NAME...]     (no args = run all)
let F = require("fft")
let L = require("lib")
let chk, test, push = L.chk, L.test, L.push

let eg = {}

eg["welford"] = fn():
  let num = F.adds({1, 2, 3, 4, 5})
  ^chk({"n", num.n, 5},
        {"mu", num.mu, 3},
        {"sd", F.sd(num), 1.5811, 1e-3})

eg["merge"] = fn():
  let c = F.merge(F.adds({1, 2, 3}), F.adds({4, 5, 6}))
  ^chk({"n", c.n, 6}, {"mu", c.mu, 3.5})

eg["norm"] = fn():
  let num = F.adds({1, 2, 3, 4, 5})
  ^chk({"mid", F.norm(num, 3), 0.5, 0.01},
        {"lo", F.norm(num, -99) < 0.01, true},
        {"hi", F.norm(num, 99) > 0.99, true})

eg["data"] = fn():
  let d = F.Data({{"name", "Age-", "Weight+", "job!"},
               {"tim", 10, 20, "prof"},
               {"ann", 20, 40, "doc"}})
  ^chk({"xcols", #d.x, 1},
        {"ycols", #d.y, 3},
        {"rows", #d.rows, 2},
        {"klass", d.klass, 4},
        {"goal+", d.goal[3], 1},
        {"goal-", d.goal[2], 0})

eg["disty"] = fn():
  let src = {{"x", "Y-"}}
  for i = 1, 5: push(src, {"a", i})
  let d = F.Data(src)
  ^chk({"lo<hi", F.disty(d, {"a", 1}) < F.disty(d, {"a", 5}), true})

eg["tree"] = fn():
  let src = {{"x", "Y-"}}
  for i = 1, 20: push(src, {i <= 10 and "a" or "b", i <= 10 and 1 or 10})
  let d = F.Data(src)
  let y = fn(r): ^F.disty(d, r)
  let trees = F.grows(d, y, d)
  let best = F.tune([b.tree for _, b in ipairs(trees)], d.rows, y)
  ^chk({"trees", #trees >= 1, true},
        {"pred", type(F.predict(best, {"a", 1})), "number"})

os.exit(test(eg))
