# funny.rc - sourced after $(KONFIG)/bashrc by `make sh`.
# Overrides the konfig `vi` alias with a function that adds
# the .fun syntax overlay and accepts positional args.

FUN_RTP="${FUN_RTP:-$(pwd)/etc}"

unalias vi 2>/dev/null
vi() {
  local init=""
  [ -f "${KONFIG:-.}/init.lua" ] && init="-u ${KONFIG}/init.lua"
  NVIM_APPNAME="${APP:-funny}" nvim --clean $init \
    -c "set rtp+=$FUN_RTP" \
    "$@"
}

# transpile any .fun file via funny.lua
fun2lua() { lua -e 'io.write(require("funny")(io.read("*a")))' < "$1"; }
