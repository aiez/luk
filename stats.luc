-- vim: ft=lua ts=2 sw=2 sts=2 et :
-- stats.luc: non-parametric stats for comparing treatments.
-- (c) 2026, Tim Menzies <timm@ieee.org>, MIT license
-- usage:  $S = require("stats")
--         if S.sames(xs, ys) then ...

$L = require("lib")
$sort, keys, keysort, slice = L.sort, L.keys, L.keysort, L.slice
$abs, max, floor = math.abs, math.max, math.floor

fn welfords(xs)             -- batch mu, sd of a list (Welford)
  $n, mu, m2 = 0, 0, 0
  for v in xs do
    n = n + 1
    $d = v - mu
    mu = mu + d / n
    m2 = m2 + d * (v - mu) end
  @mu, (n < 2 and 0 or (m2 / (n - 1)) ^ 0.5) end

fn bisect(t, x, strict)     -- count t[i]<=x (<x if strict); t sorted
  $lo, hi = 1, #t
  while lo <= hi do
    $mid = floor((lo + hi) / 2)
    if strict and t[mid] < x or (not strict) and t[mid] <= x then
      lo = mid + 1
    else
      hi = mid - 1 end end
  @lo - 1 end

fn pooledSd(xs, ys)         -- pooled stdev of two raw samples
  $nx, sx = #xs, (select(2, welfords(xs)))
  $ny, sy = #ys, (select(2, welfords(ys)))
  @(((nx-1)*sx*sx + (ny-1)*sy*sy) / (nx+ny-2)) ^ 0.5 end

fn cliffsDelta(xs, ys)      -- effect size; ys pre-sorted
  $n, p, ngt, nlt = #xs, #ys, 0, 0
  for v in xs do
    ngt = ngt + bisect(ys, v, true)
    nlt = nlt + (p - bisect(ys, v)) end
  @abs(ngt - nlt) / (n * p) end

fn ks(xs, ys)               -- Kolmogorov-Smirnov gap; pre-sorted
  $n, p, d = #xs, #ys, 0
  fn gap(v) @abs(bisect(xs, v)/n - bisect(ys, v)/p) end
  for v in xs do d = max(d, gap(v)) end
  for v in ys do d = max(d, gap(v)) end
  @d end

fn sames(xs, ys, eps, cliffs, ksconf)
  $eps, cliffs, ksconf = eps or 0, cliffs or 0.195, ksconf or 1.36
  $a = sort(slice(xs))
  $b = sort(slice(ys))
  $n, p = #a, #b
  if abs(a[floor(n/2)+1] - b[floor(p/2)+1]) <= eps then @true end
  if cliffsDelta(a, b) > cliffs then @false end
  @ks(a, b) <= ksconf * ((n + p) / (n * p)) ^ 0.5 end

fn topTier(dict, cmp, eps, cliffs, ksconf)
  $out = {}
  $names = keysort(keys(dict), fn(k) @(welfords(dict[k])) end, cmp)
  $best = dict[names[1]]
  out[names[1]] = (welfords(best))
  for i = 2, #names do
    $cand = dict[names[i]]
    $th = (eps or 0) * pooledSd(best, cand)
    if not sames(best, cand, th, cliffs, ksconf) then break end
    out[names[i]] = (welfords(cand)) end
  @out end

@{welfords=welfords, bisect=bisect, pooledSd=pooledSd,
   cliffsDelta=cliffsDelta, ks=ks, sames=sames, topTier=topTier}
