-- vim: ft=lua ts=2 sw=2 sts=2 et :
-- fft.luk: fast-frugal multi-objective tree. End syntax.
-- (c) 2026, Tim Menzies <timm@ieee.org>, MIT license
--
-- Options:
--   -s seed     seed=1234567891
--   -p p        distance exponent  p=2
--   -b bins     bins=7
--   -d depth    depth=4
--   -R Round    Round=2
--   -f file     file=../optimiz/auto93.csv

BIG := 1E32
L := require("lib")
abs,argmin,of,csv,sort := L.abs,L.argmin,L.of,L.csv,L.sort
floor,sum              := L.floor, L.sum
max, min, sqrt, exp    := L.max, L.min, L.sqrt, L.exp

randomseed := math.randomseed

the := {seed=1234567891, p=2, bins=7, depth=4, Round=2,
        file=(os.getenv("DOOT") or "..")..
             "/optimiz/auto93.csv"}

-- forward decls (so closures can reference)
local add, adds, disty, qty, grows, show

-- 1. Columns ------------------------------------------------
Sym := fn() ^ {symp=true, has={}} end
Num := fn(n,mu,m2) ^{nump=true,n=n or 0,mu=mu or 0,m2=m2 or 0} end

sd := fn(num)
  if num.n < 2 then ^ 0 end
  ^ sqrt(max(0, num.m2) / (num.n - 1)) end

welford := fn(num, v, w)
  n := num.n + w
  if n <= 0 then ^ Num() end
  d := v - num.mu
  mu := num.mu + w * d / n
  ^ Num(n, mu, num.m2 + w * d * (v - mu)) end

norm := fn(num, v)
  z := (v - num.mu) / (sd(num) + 1/BIG)
  ^ 1 / (1 + exp(-1.7 * max(-3, min(3, z)))) end

merge := fn(i, j, w)
  w := w or 1
  if i.symp then
    u := Sym()
    for _, p in ipairs({{i,1}, {j,w}}) do
      for k, vv in pairs(p[1].has) do
        u.has[k] = (u.has[k] or 0) + p[2] * vv end end
    ^ u end
  n := i.n + w * j.n
  if n <= 0 then ^ Num() end
  mu := (i.n*i.mu + w * j.n * j.mu) / n
  d  := j.mu - i.mu
  m2 := i.m2 + w*j.m2 + w*d*d*i.n*j.n / n
  ^ Num(n, mu, m2) end

-- 2. Data ---------------------------------------------------
Data := fn(src)
  it := {names={}, klass=nil, x={}, y={},
         goal={}, cols={}, rows={}}
  roles := fn(names)
    it.names = names
    for at, s in ipairs(names) do
      z := s:sub(-1)
      first := s:sub(1,1)
      it.cols[at] = (first == first:lower() and Sym or Num)()
      if z == "-" or z == "+" or z == "!" then
        table.insert(it.y, at)
        it.goal[at] = (z == "+") and 1 or 0
      elseif z ~= "X" then table.insert(it.x, at) end
      if z == "!" then it.klass = at end end end
  roles(src[1])
  for i = 2, #src do it = add(it, src[i]) end
  ^ it end

add = fn(it, v)
  if v == "?" then ^ it end
  if     it.symp then it.has[v] = (it.has[v] or 0) + 1
  elseif it.nump then it = welford(it, v, 1) 
  else
    table.insert(it.rows, v)
    it.cols = [add(it.cols[at], x) for at, x in ipairs(v)] end
  ^ it end

adds = fn(src, it)
  it := it or Num()
  for _, x in ipairs(src) do it = add(it, x) end
  ^ it end

-- 3. Discretization ----------------------------------------
cutsSyms := fn(bins, tot, hi, at)
  u := {}
  for k, l in pairs(bins) do
    score := l.m2 + merge(tot, l, -1).m2
    u[#u+1] = {score=score, at=at, lo=hi[k], hi=hi[k],leaf=l} end
  ^ u end

cutsNums := fn(bins, tot, hi, at)
  u := {}
  ks := sort([k for k, _ in pairs(bins)])
  l := Num()
  for j = 1, #ks - 1 do
    k := ks[j]
    l = merge(l, bins[k])
    score := l.m2 + merge(tot, l, -1).m2
    u[#u+1] = {score=score, at=at, lo=-BIG, hi=hi[k], leaf=l} end
  ^ u end

cuts := fn(data, rows, y)
  u, ys := {}, [y(r) for _, r in ipairs(rows)]
  for _, at in ipairs(data.x) do
    c := data.cols[at]
    tot, bins, hi := Num(), {}, {}
    for i, r in ipairs(rows) do
      v := r[at]
      if v ~= "?" then
        k := (c.symp and v) or floor(the.bins*norm(c, v))
        bins[k] = add(bins[k] or Num(), ys[i])
        tot     = add(tot, ys[i])
        hi[k] = c.symp and v or max(hi[k] or -BIG, v) end end
    inner := (c.symp and cutsSyms or cutsNums)(
               bins, tot, hi, at)
    for _, x in ipairs(inner) do u[#u+1] = x end end
  ^ u end

-- 4. Build a tree ------------------------------------------
disty = fn(data, row)
  p, s := the.p, 0
  for _, at in ipairs(data.y) do
    s = s + abs(norm(data.cols[at], row[at])
                - data.goal[at]) ^ p end
  ^ (s / #data.y) ^ (1 / p) end

has := fn(v, lo, hi) ^ v == "?" or (lo <= v and v <= hi) end

rest := fn(rows, at, lo, hi)
  ^ [r for _, r in ipairs(rows) if not has(r[at], lo, hi)] end

grows = fn(data, y, root, d)
  d := d or 0
  u := {}
  if d < the.depth then
    cs := [c for _, c in ipairs(cuts(data, data.rows, y))
             if c.leaf.n > (#root.rows) ^ 0.33]
    if #cs > 0 then
      sort(cs, fn(a,b) ^ a.leaf.mu < b.leaf.mu end)
      for bit, c in ipairs({cs[1], cs[#cs]}) do
        no := rest(data.rows, c.at, c.lo, c.hi)
        if #no > 0 then
          child := {data.names}
          for _, r in ipairs(no) do table.insert(child, r) end
          bs := grows(Data(child), y, root, d+1)
          for _, br in ipairs(bs) do
            u[#u+1] = {bias=tostring(bit-1) .. br.bias,
                       tree={at=c.at, lo=c.lo, hi=c.hi,
                             left=c.leaf,
                             right=br.tree}} end end end end end
  if #u == 0 then
    ys := [y(r) for _, r in ipairs(data.rows)]
    u[#u+1] = {bias="", tree=adds(ys)} end
  ^ u end

-- 5. Use a tree --------------------------------------------
predict := fn(t, row)
  while not t.nump do
    t = has(row[t.at], t.lo, t.hi) and t.left or t.right end
  ^ t.mu end

tune := fn(cands, rows, y)
  err := fn(t)
    ^ sum([abs(y(r) - predict(t, r))
           for _, r in ipairs(rows)]) / #rows end
  ^ argmin(cands, err) end

show = fn(data, t)
  if t.nump then
    print(("%-33s leaf  d2h %.2f n=%d"):fmt("", t.mu, t.n))
    ^ nil end
  nm := data.names[t.at]
  c := ""
  if t.lo == t.hi then
    c = ("%s == %s"):fmt(nm, tostring(t.lo))
  elseif t.lo == -BIG then
    c = ("%s <= %s"):fmt(nm, tostring(qty(t.hi)))
  else
    c = ("%s >= %s"):fmt(nm, tostring(qty(t.lo))) end
  lf := t.left
  print(("if %-30s then d2h %.2f n=%d"):fmt(
    c, lf.mu, lf.n))
  show(data, t.right) end

-- 6. IO ----------------------------------------------------
qty = fn(v)
  if type(v) == "number" then
    if floor(v) == v then ^ floor(v) end
    ^ tonumber(("%."..the.Round.."f"):fmt(v)) end
  ^ v end

-- 7. Tests/demos -------------------------------------------
test_main := fn()
  data := Data(csv(the.file))
  y := fn(r) ^ disty(data, r) end
  cands := [b.tree for _, b in ipairs(grows(data, y, data))]
  show(data, tune(cands, data.rows, y)) end

test_trees := fn()
  data  := Data(csv(the.file))
  y     := fn(r) ^ disty(data, r) end
  trees := grows(data, y, data)
  for i, bt in ipairs(trees) do
    t := bt.tree
    e := sum([abs(y(r) - predict(t, r))
              for _, r in ipairs(data.rows)]) / #data.rows
    print(("===== tree %2d   bias %-5s   err %.3f ====="):fmt(
      i, bt.bias, e))
    show(data, t)
    print() end end

-- 8. Start-up ----------------------------------------------
for i = 1, #arg - 1 do
  for k, _ in pairs(the) do
    if arg[i] == "-" .. k:sub(1,1) then
      the[k] = of(arg[i+1]) end end end

randomseed(the.seed)

mode := "main"
for _, a in ipairs(arg) do
  if a == "--trees" then mode = "trees" end end
(mode == "trees" and test_trees or test_main)()
